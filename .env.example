# Supabase Configuration
# Replace these with your actual keys from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Only used server-side for admin tasks)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── SMS OTP Gateway (choose one) ───────────────────────────

# Option 1: Fast2SMS (Recommended for India)
# Get your API key at https://www.fast2sms.com/
# FAST2SMS_API_KEY=your-fast2sms-api-key-here

# Option 2: Twilio (International)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Note: If no SMS provider is configured, OTP codes will be
# logged to the server console for development/testing.
